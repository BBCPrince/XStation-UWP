#version 450
layout(local_size_x=1,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0) uniform texture2D source_image;
layout(set=0,binding=1) uniform sampler source_sampler;
layout(set=0,binding=2,std430) buffer Result { vec4 color; } output_data;
void main() {
    output_data.color=textureLod(sampler2D(source_image,source_sampler),vec2(0.5),0.0);
}
